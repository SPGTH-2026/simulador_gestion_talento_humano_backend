APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL. Este proyecto NO usa sqlite: la extensión pdo_sqlite no está
# garantizada, así que tanto desarrollo como pruebas usan MySQL.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bd_spgth
DB_USERNAME=root
DB_PASSWORD=

# Base DEDICADA para pruebas (ver README: Entorno de desarrollo). NUNCA es
# bd_spgth, para no tocar los datos de desarrollo. Debe existir antes de
# correr `php artisan test`.
# DB_DATABASE_TESTING=bd_spgth_testing

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo saliente. En desarrollo se puede dejar MAIL_MAILER=log: el código OTP
# se escribe en storage/logs/laravel.log y NO se envía a ningún buzón.
# Para envío REAL con Gmail: activar 2FA en Google, generar una "Contraseña de
# aplicación" y usar esta configuración (MAIL_FROM_ADDRESS debe ser el mismo
# correo autenticado, o Gmail rechaza el envío):
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=null
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=tu-correo@gmail.com
#   MAIL_PASSWORD=contraseña-de-aplicacion
#   MAIL_FROM_ADDRESS="tu-correo@gmail.com"
#   MAIL_FROM_NAME="${APP_NAME}"
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Gestión Documental: almacenamiento externo (Cloudflare R2) ──────────
# DOCUMENTOS_DISK usa 'documentos' (R2) en producción y 'local' en desarrollo,
# donde los archivos caen en storage/app/private (no se necesita cuenta).
# Para crear las credenciales: Cloudflare > R2 > Manage R2 API Tokens > crear
# token con permiso 'Object Read & Write' sobre el bucket de documentos.
# El endpoint es https://<account-id>.r2.cloudflarestorage.com.
# El bucket debe ser PRIVADO: sin dominio público ni R2.dev. Los archivos se
# sirven siempre por el proxy del backend (disco 'documentos', visibility private).
# DOCUMENTOS_DISK=documentos
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_REGION=auto
# R2_BUCKET=spgth-documentos
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_URL=

VITE_APP_NAME="${APP_NAME}"

SANCTUM_EXPIRATION=480
SANCTUM_IDLE_MINUTES=15
FRONTEND_URL=http://localhost:5173
# Orígenes permitidos por CORS, separados por coma. Si se omite, se usa
# FRONTEND_URL. Debe incluir el esquema y el puerto exactos del frontend.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000,127.0.0.1:8000
